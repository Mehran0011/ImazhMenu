<body>
    <main id="main">
        <!-- ======= Top Bar ======= -->
        <section id="topbar" class="fixed-top topbar-transparent">
            <div class="row p-4 px-3">
               <div class="col-lg-2 col-md-4 col-sm-12 col-12 text-center">
                <i class="bi bi-phone ms-4 d-lg-flex align-items-center"><span>026-36272604</span></i>
               </div> 
               <div class="col-lg-10 col-md-6 col-sm-12 col-12 text-center">
