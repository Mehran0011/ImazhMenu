                        <li><a class="nav-link scrollto" href="#contact">تماس با ما</a></li>
                        <li><a class="nav-link scrollto" href="#gallery">گالری</a></li>
                        <li><a class="nav-link scrollto" href="#menu">منو</a></li>
                        <li><a class="nav-link scrollto active" href="#hero">خانه</a></li>

                    </ul>
                    <i class="bi bi-list mobile-nav-toggle"></i>
                </nav><!-- .navbar -->
            </div>
        </header><!-- End Header -->
        <!-- ======= Hero Section ======= -->
        <section id="hero">
            <div class="hero-container">
                <div id="heroCarousel" data-bs-interval="5000" class="carousel slide carousel-fade" data-bs-ride="carousel">
                    <div class="carousel-inner" role="listbox">

                        <!-- Slide 1 -->
                        <div class="carousel-item active" style="background-image: url(Images/IMG_20230831_223121.jpg);">
                            <div class="carousel-container">
                                <div class="carousel-content mt-5">
                                    <h2 class="animate__animated animate__fadeInDown"><span>ایماژ</span>،نگاره ای از طعم و خاطره هایی که نمیشه ازشون گذشت</h2>
                                    <p><span>لبخند</span> بزنید و از بوی خوش قهوه لذت ببرید</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section><!-- End Hero -->
        @RenderBody()
    </main><!-- End #main -->
