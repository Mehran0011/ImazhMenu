@model CustomerClub
@{
    Layout = "_DashboardLayout";
}
  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">پنل مدیریت ایماژ</h1>
          </div><!-- /.col -->
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-left">
              <li class="breadcrumb-item"><a href="#">خانه</a></li>
              <li class="breadcrumb-item active">پنل مدیریت ایماژ</li>
            </ol>
          </div><!-- /.col -->
        </div><!-- /.row -->
      </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->

<div id="CustomerClubSection">
    <div class="m-5">
        <h4 class="mt-3">لیست باشگاه مشتریان</h4>
        <div class="card">
            <div class="card-body" >
                <table id="tblCustomerClubData" class="table table-hover table-bordered pt-4 pb-4" style="width:100%">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                نام مشتری
                            </th>
                            <th>
                                موضوع
                            </th>
                            <th>
                              شماره تلفن
                            </th>
                            <th>
                                متن پیام
                            </th>
                            <th>

                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/customerclub.js"></script>
}