@model AdminPanelViewModel
@{
    Layout = "_DashboardLayout";
}
  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">پنل مدیریت ایماژ</h1>
          </div><!-- /.col -->
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-left">
              <li class="breadcrumb-item"><a href="#">خانه</a></li>
              <li class="breadcrumb-item active">پنل مدیریت ایماژ</li>
            </ol>
          </div><!-- /.col -->
        </div><!-- /.row -->
      </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->

<div id="SubCategorySection">
    <div class="m-5">
        <h4>ایجاد محصول</h4>
        <div class="card">
            <div class="card-body">
                <form asp-controller="Account" asp-action="CreateNewSubCategory" enctype="multipart/form-data">
                    <div class="row mb-3">
                        <div class="form-group col-6 mb-3">
                            <label for="exampleFormControlSelect2" class="mb-3">دسته بندی محصولات</label>
                            <select class="form-control" name="categoryId" id="createCategorydrp" asp-for="CategoryRef">
                                <!-- Add options dynamically or statically -->
                            </select>
                        </div>
                        <div class="form-group col-6 mb-3">
                            <label for="exampleFormControlTextarea1" class="mb-3">محصول</label>
                            <input type="text" class="form-control" id="exampleFormControlInput1" asp-for="SubCactegoryName" placeholder="نام محصول را وارد کنید">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-6 mb-3">
                            <label for="exampleFormControlTextarea1" class="mb-3">قیمت محصول</label>
                            <input type="text" class="form-control" id="exampleFormControlInput1" asp-for="Price" placeholder="قیمت محصول را به تومان وارد کنید">
                        </div>
                        <div class="form-group col-6 mb-3 d-flex align-items-center mt-5">
                            <label for="exampleFormControlFile1">تصویر محصول</label>
                            <input type="file" class="form-control-file px-3" name="file" asp-for="SubCatImgUrl" id="exampleFormControlFile1">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-6 mb-3">
                            <label for="exampleFormControlTextarea1" class="mb-3">توضیحات محصول</label>
                            <textarea class="form-control" id="exampleFormControlTextarea1" asp-for="Description" placeholder="توضیحات محصول را وارد کنید" style="height:150px;resize:none"></textarea>
                        </div>
                    </div>

                    <!-- Checkbox for IsActive -->
                    <div class="row">
                        <div class="form-group col-6 mb-3">
                            <label for="IsActive" class="mb-3">فعال شود</label>
                            <input type="checkbox" class="form-check-input" style="margin-right:20px" asp-for="IsActive">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mx-3">ثبت</button>
                </form>
            </div>
        </div>

        <h4 class="mt-3">لیست محصولات</h4>
        <div class="card">
            <div class="card-body">
                 <select class="form-control mb-4" name="categoryId" id="createCategorydrp1" asp-for="CategoryRef">
                                <!-- Add options dynamically or statically -->
                 </select>
                <table id="tblSubCategoryData" class="table table-hover table-bordered pt-4 pb-4" style="width:100%">
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/subcategory.js"></script>
}
