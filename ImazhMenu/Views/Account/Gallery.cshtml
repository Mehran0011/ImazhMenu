@model Gallery
@{
    Layout = "_DashboardLayout";
}
  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">پنل مدیریت ایماژ</h1>
          </div><!-- /.col -->
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-left">
              <li class="breadcrumb-item"><a href="#">خانه</a></li>
              <li class="breadcrumb-item active">پنل مدیریت ایماژ</li>
            </ol>
          </div><!-- /.col -->
        </div><!-- /.row -->
      </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->

<div id="GallerySection">
    <div class="m-5">
        <h4>افزودن عکس به گالری</h4>
        <div class="card">
            <div class="card-body">
                <form asp-controller="Account" asp-action="Gallery" enctype="multipart/form-data">
                    <div class="row">
                        <div class="form-group col-6 mb-3 d-flex align-items-center mt-5">
                            <label for="exampleFormControlFile1">تصاویر گالری</label>
                            <input type="file" class="form-control-file px-3" name="file" asp-for="ImgUrl" id="exampleFormControlFile1" multiple>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mx-3">ثبت</button>
                </form>
            </div>
        </div>
        <h4 class="mt-3">لیست تصاویر گالری</h4>
        <div class="card">
            <div class="card-body">
                <table id="tblGalleryData" class="table table-hover table-bordered pt-4 pb-4" style="width:100%">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                تصویر گالری
                            </th>
                            <th>

                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/gallery.js"></script>
}