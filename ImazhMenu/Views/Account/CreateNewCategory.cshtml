@model Category
@{
    Layout = "_DashboardLayout";
}
  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">پنل مدیریت ایماژ</h1>
          </div><!-- /.col -->
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-left">
              <li class="breadcrumb-item"><a href="#">خانه</a></li>
              <li class="breadcrumb-item active">پنل مدیریت ایماژ</li>
            </ol>
          </div><!-- /.col -->
        </div><!-- /.row -->
      </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->

<div id="CategorySection">
    <div class="m-5">
        <h4>ایجاد دسته بندی جدید</h4>
        <div class="card mb-5">
            <div class="card-body">
                <form method="post" asp-action="CreateNewCategory">
                    <div class="input-group mb-3">
                        <div class="row align-items-center mx-2">
                            <label> دسته بندی</label>
                        </div>
                        <div class="row">
                            <input asp-for="CactegoryName" type="text" class="form-control" placeholder="دسته بندی را وارد کنید" aria-label="Username" aria-describedby="basic-addon1">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mx-3">ثبت</button>
                </form>
            </div>
        </div>      
        <h4>لیست دسته بندی ها</h4>
        <div class="card">
            <div class="card-body" style="">
                <table id="tblCategoryData" class="table table-hover table-bordered pt-4 pb-4" style="width:100%">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                نام دسته بندی
                            </th>
                            <th>

                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/js/category.js"></script>
}