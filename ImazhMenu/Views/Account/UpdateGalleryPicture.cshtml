@model Gallery
@{
    Layout = "_DashboardLayout";
}
  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">پنل مدیریت حاصل</h1>
          </div><!-- /.col -->
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-left">
              <li class="breadcrumb-item"><a href="#">خانه</a></li>
              <li class="breadcrumb-item active">پنل مدیریت حاصل</li>
            </ol>
          </div><!-- /.col -->
        </div><!-- /.row -->
      </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->

<div>
    <div class="m-5">
        <h4>ویرایش تصویر گالری</h4>
        <div class="card">
            <div class="card-body">
                <form asp-controller="Account" asp-action="UpdateGalleryPicture" enctype="multipart/form-data">
                    <input asp-for="Id" hidden />
                    <input asp-for="ImgUrl" name="oldimageurl" hidden />
                    <div class="row">
                        <div class="form-group col-6 mb-3 d-flex align-items-center mt-5">
                            <label for="exampleFormControlFile1">تصویر گالری</label>
                            <input type="file" class="form-control-file px-3" name="file" id="exampleFormControlFile1">
                        </div>
                        <div class="form-group col-6 mb-3 text-center">
                            <img src="/@Model.ImgUrl" height="250px" width="250px" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mx-3">ثبت</button>
                </form>
            </div>
        </div>
    </div>
</div>
