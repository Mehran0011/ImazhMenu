@model Category
@{
    Layout = "_DashboardLayout";
}
  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">پنل مدیریت حاصل</h1>
          </div><!-- /.col -->
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-left">
              <li class="breadcrumb-item"><a href="#">خانه</a></li>
              <li class="breadcrumb-item active">پنل مدیریت حاصل</li>
            </ol>
          </div><!-- /.col -->
        </div><!-- /.row -->
      </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->

<div>
    <div class="m-5">
        <h4>ویرایش دسته بندی</h4>
        <div class="card mb-5">
            <div class="card-body">
                <form method="post" asp-action="UpdateCategory">
                    <div class="input-group mb-3">
                        <div class="row align-items-center mx-2">
                            <label> دسته بندی</label>
                        </div>
                        <div class="row">
                            <input asp-for="Id" hidden>
                            <input asp-for="CactegoryName" type="text" class="form-control" aria-label="Username" aria-describedby="basic-addon1">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mx-3">ثبت</button>
                </form>
            </div>
        </div>
    </div>
</div>