@{
    Layout = "_DashboardLayout";
}
  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">پنل مدیریت حاصل</h1>
          </div><!-- /.col -->
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-left">
              <li class="breadcrumb-item"><a href="#">خانه</a></li>
              <li class="breadcrumb-item active">پنل مدیریت حاصل</li>
            </ol>
          </div><!-- /.col -->
        </div><!-- /.row -->
      </div><!-- /.container-fluid -->
    </div>
    <!-- /.content-header -->

<div class="row p-3">
  <div class="col-12">
                      <a asp-page="/Account/AddProduct" class="btn btn-primary btn-md"><i class="fa fa-plus"></i> افزودن محصول</a>
                      </br>
                      </br>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">جدول محصولات</h3>

        <div class="card-tools">
          <div class="input-group input-group-sm" style="width: 150px;">
            <input type="text" name="table_search" class="form-control float-right" placeholder="Search">

            <div class="input-group-append">
              <button type="submit" class="btn btn-default"><i class="fa fa-search"></i></button>
            </div>
          </div>
        </div>
      </div>
      <!-- /.card-header -->
      <div class="card-body table-responsive p-0">
        <table class="table table-hover" id="tblSubCategoryData">
          <thead>
            <tr>
                            <th>
                                #
                            </th>
                            <th>
                                تصویر محصول
                            </th>
                            <th>
                                نام محصول
                            </th>
                            <th>
                                قیمت محصول
                            </th>
                            <th>
                                توضیحات
                            </th>
                            <th>
                                وضعیت
                            </th>
                            <th>
                            </th>
            </tr>
          </thead>
        </table>
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->
  </div>
</div>

</div>
@section Scripts {
    <script src="~/js/subcategory.js"></script>
}
